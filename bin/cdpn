#!/usr/bin/env node
import { parseArgs } from "node:util";
import * as env from "../lib/env.js";
import * as pen from "../lib/pen.js";
import { ApiError } from "../lib/api.js";
import { serial, watch } from "../lib/watch.js";
import * as init from "../lib/init.js";
import * as info from "../lib/info.js";
import * as browser from "../lib/browser.js";

const USAGE = `cdpn — mirror a local directory to a CodePen 2.0 Pen

  cdpn init [PEN]       set up .env, .envrc and .gitignore here; PEN pulls it
  cdpn push [--force]   push local files (creates a Pen if CODEPEN_ID is unset)
  cdpn pull [PEN]       download the Pen's files; PEN (id or URL) connects to it
  cdpn sync [--force]   push, then watch and push on every change
  cdpn info             show the Pen's details and local sync status
  cdpn open [TARGET]    open editor (default), preview or live in the browser

env (.env):
  CODEPEN_API_KEY   key or 1Password ref, e.g. "op://Private/CodePen/API Key"
  CODEPEN_ID        Pen id, written automatically on first push
  CODEPEN_DIR       directory to mirror (default: .)

--key    init: API key or 1Password ref for a new .env (default: "${init.DEFAULT_KEY}")
--force  push/sync: skip the version check and overwrite remote edits
         pull: switch to PEN although another Pen is connected`;

function explain(error) {
  if (error instanceof ApiError && error.code === "CONFLICT")
    return "the Pen changed remotely (editor?). run `cdpn pull` first, or push with --force";
  if (error instanceof ApiError && error.code === "NOT_FOUND")
    return "Pen not found. The API only reaches your own Pens (fork someone else's on codepen.io first)";
  return error.message;
}

function connected() {
  const p = pen.open();
  if (!p.id) throw new Error("no Pen connected: run `cdpn push` or `cdpn pull <PEN>`");
  return p;
}

const TARGETS = {
  editor: (meta) => meta.urls.editor,
  preview: (meta) => meta.urls.preview,
  live: (meta) => meta.deployment?.url,
};

async function openPen({ target = "editor" }) {
  const url = TARGETS[target];
  if (!url) throw new Error(`unknown target "${target}": use ${Object.keys(TARGETS).join(", ")}`);
  const p = connected();
  const href = url(await p.api.pen(p.id));
  if (!href) throw new Error(`the Pen has no ${target} URL (not deployed?)`);
  console.log(href);
  browser.open(href);
}

async function setup(options) {
  init.report(init.scaffold(options));
  if (init.allowDirenv()) console.log("  direnv allowed");
  env.load();
  if (options.penRef) return pen.pull(pen.open(), options);
  console.log("next: `cdpn push` creates a Pen, `cdpn pull <PEN>` connects an existing one");
}

async function sync(options) {
  const p = pen.open();
  const push = serial(() =>
    pen.push(p, options).catch((error) => console.error(`✗ ${explain(error)}`)),
  );
  watch(p.dir, push);
  await push();
  if (p.urls) console.log(`editor  ${p.urls.editor}\npreview ${p.urls.preview}`);
  console.log(`watching ${p.dir}`);
}

const commands = {
  init: setup,
  push: (options) => pen.push(pen.open(), options),
  pull: (options) => pen.pull(pen.open(), options),
  sync,
  info: async () => console.log(info.render(await info.gather(connected()))),
  open: openPen,
};

const { positionals, values } = parseArgs({
  allowPositionals: true,
  options: { force: { type: "boolean" }, key: { type: "string" }, help: { type: "boolean", short: "h" } },
});
const command = commands[positionals[0]];
if (!command || values.help) {
  console.log(USAGE);
  process.exit(command || values.help ? 0 : 1);
}

try {
  env.load();
  await command({ force: values.force, key: values.key, penRef: positionals[1], target: positionals[1] });
} catch (error) {
  console.error(`✗ ${explain(error)}`);
  process.exit(1);
}
